# In Vite, we prefix all environment variables with `VITE_`, We call it -> exaple: import.meta.env.VITE_API_BASE_URL

# used in vite.config.ts proxy, On Vercel deployment, we set it to full URL, exaple: VITE_API_BASE_URL=https://your-backend-domain.com/api/v1
VITE_API_BASE_URL=/api/v1

# change localhost URL to your real production domain
VITE_FRONTEND_ORIGIN=http://localhost:3000